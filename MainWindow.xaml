<Window x:Class="SPPR.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Лабораторна №1 СППР - Їжа" Height="760" Width="1100" MinHeight="600" MinWidth="900">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Зберегти" Width="120" Margin="0,0,8,0" Command="{Binding SaveCommand}"/>
            <Button Content="Завантажити" Width="120" Margin="0,0,8,0" Command="{Binding LoadCommand}"/>
            <Button Content="Скинути до стандартних" Width="180" Command="{Binding ResetCommand}"/>
        </StackPanel>

        <GroupBox Grid.Row="1" Header="Оберіть ознаки" Margin="0,0,0,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Features}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="6"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </GroupBox>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Результати розпізнавання" Margin="0,0,8,0">
                <DockPanel>
                    <Button Content="Розпізнати" Command="{Binding RecognizeCommand}" DockPanel.Dock="Top" Margin="8" Height="30"/>
                    <DataGrid ItemsSource="{Binding Results}" AutoGenerateColumns="False" IsReadOnly="True" Margin="8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Об'єкт" Binding="{Binding ObjectName}" Width="*"/>
                            <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="100"/>
                            <DataGridCheckBoxColumn Header="Переможець" Binding="{Binding IsWinner}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Навчання та пояснення" Margin="8,0,0,0">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Прогноз:" FontWeight="Bold"/>
                        <TextBlock Text="{Binding PredictedObjectName}" Margin="0,0,0,6"/>

                        <TextBlock Text="Правильний об'єкт:" FontWeight="Bold"/>
                        <ComboBox ItemsSource="{Binding Objects}" SelectedItem="{Binding SelectedTrueObject}" Margin="0,2,0,8"/>

                        <Button Content="Навчити" Command="{Binding TrainCommand}" Width="120" Height="30"/>
                    </StackPanel>

                    <TextBlock Text="Пояснення внеску ознак для переможця:" FontWeight="Bold" Margin="0,6,0,4"/>
                    <TextBox Text="{Binding ExplanationText}" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" IsReadOnly="True" MinHeight="100" Margin="0,0,0,8"/>

                    <TextBlock Text="Зміни ваг після навчання:" FontWeight="Bold" Margin="0,4,0,4"/>
                    <TextBox Text="{Binding TrainingChangesText}" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" IsReadOnly="True" MinHeight="100"/>
                </DockPanel>
            </GroupBox>
        </Grid>

        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
